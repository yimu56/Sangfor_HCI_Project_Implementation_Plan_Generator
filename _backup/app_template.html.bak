<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>深信服云计算平台实施方案 · 生成器</title>
<style>
:root{
  --bd:#e2e6ec; --bd2:#cbd2db; --bg:#f2f4f7; --card:#fff; --ink:#1c2026; --ink2:#5f6672;
  --acc:#0b6bcb; --acc-bg:#e9f2fd; --ok:#0f9d58; --warn:#c77700; --danger:#d93025;
  --h:54px;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{
  font:13px/1.6 -apple-system,"Segoe UI","Microsoft YaHei",sans-serif;
  color:var(--ink); background:var(--bg); overflow:hidden;
}
button{font:inherit;cursor:pointer}
input,textarea{font:inherit;color:inherit}

/* ---------- 顶栏 ---------- */
.topbar{
  height:var(--h); background:#fff; border-bottom:1px solid var(--bd);
  display:flex; align-items:center; gap:14px; padding:0 16px; position:relative; z-index:20;
}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:14px;white-space:nowrap}
.brand i{
  width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,#0b6bcb,#39a3ff);
  display:inline-flex;align-items:center;justify-content:center;color:#fff;font-style:normal;font-size:14px;font-weight:800;
}
.brand small{font-weight:400;color:var(--ink2);font-size:11px;margin-left:2px}
.spacer{flex:1}
.btn{
  border:1px solid var(--bd2); background:#fff; color:var(--ink); border-radius:7px;
  padding:6px 12px; font-size:13px; white-space:nowrap; transition:.15s;
}
.btn:hover{border-color:var(--acc); color:var(--acc); background:#f7fbff}
.btn.primary{background:var(--acc); border-color:var(--acc); color:#fff}
.btn.primary:hover{background:#0a5cb0; color:#fff}
.btn.ghost{border-color:transparent;background:transparent;color:var(--ink2)}
.btn.ghost:hover{background:#f0f2f5;color:var(--ink)}
.btn.sm{padding:3px 8px;font-size:12px;border-radius:6px}
.btn[disabled]{opacity:.45;cursor:not-allowed}

/* ---------- 布局 ---------- */
.layout{display:grid;grid-template-columns:430px 1fr;height:calc(100vh - var(--h))}
.left{overflow:auto;padding:14px;border-right:1px solid var(--bd)}
.right{overflow:auto;background:#e7eaee;padding:22px}
@media(max-width:1080px){.layout{grid-template-columns:1fr;height:auto}.left,.right{height:auto}}

/* ---------- 卡片 ---------- */
.card{background:var(--card);border:1px solid var(--bd);border-radius:10px;margin-bottom:10px;overflow:hidden}
.card>summary{
  list-style:none;cursor:pointer;padding:10px 12px;display:flex;align-items:center;gap:8px;
  font-weight:600;font-size:13px;user-select:none;
}
.card>summary::-webkit-details-marker{display:none}
.card>summary .caret{color:var(--ink2);transition:.15s;font-size:10px}
.card[open]>summary .caret{transform:rotate(90deg)}
.card>summary .lv{
  font-size:10px;font-weight:700;color:var(--acc);background:var(--acc-bg);
  border-radius:4px;padding:1px 5px;letter-spacing:.3px;
}
.card>summary .cnt{margin-left:auto;font-weight:400;color:var(--ink2);font-size:11px}
.card .bd{padding:4px 12px 12px}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.f{margin-bottom:9px}
.f label{display:block;font-size:11.5px;color:var(--ink2);margin-bottom:3px}
.f input,.f textarea,.f select{
  width:100%;border:1px solid var(--bd2);border-radius:7px;padding:6px 8px;background:#fff;
  outline:none;transition:.15s;
}
.f input:focus,.f textarea:focus{border-color:var(--acc);box-shadow:0 0 0 3px #0b6bcb1a}
.f textarea{resize:vertical;line-height:1.55;min-height:34px}
.f .hint{font-size:11px;color:#8a9099;margin-top:2px}

.field{margin-bottom:8px;position:relative}
.field .tag{
  display:inline-block;font-size:10px;padding:0 5px;border-radius:4px;margin-bottom:3px;
  background:#eef1f5;color:#69707c;letter-spacing:.3px
}
.field .tag.h{background:#e7f0fd;color:#0b6bcb;font-weight:700}
.field .tag.l{background:#fdf1e0;color:#a35b00}
.field textarea{
  width:100%;border:1px solid var(--bd);border-radius:8px;padding:7px 9px;background:#fcfdfe;
  resize:vertical;line-height:1.6;min-height:32px;outline:none;font-family:inherit;
  transition:.15s;
}
.field textarea:hover{border-color:var(--bd2)}
.field textarea:focus{border-color:var(--acc);background:#fff;box-shadow:0 0 0 3px #0b6bcb14}
.field input.tin{
  width:100%;border:1px solid var(--bd);border-radius:8px;padding:5px 9px;font-weight:600;
  background:#fcfdfe;outline:none
}
.field input.tin:focus{border-color:var(--acc);background:#fff}
.mline{font-size:11px;color:#98a0aa;margin:8px 0 6px;display:flex;align-items:center;gap:6px}
.mline::after{content:"";flex:1;height:1px;background:var(--bd)}
.media{
  border:1px dashed var(--bd2);border-radius:8px;padding:8px 10px;color:#8a9099;font-size:11.5px;
  background:#fafbfc;display:flex;gap:7px;align-items:center
}

/* ---------- 表格编辑器 ---------- */
.tbl{border:1px solid var(--bd);border-radius:9px;margin-bottom:9px;overflow:hidden;background:#fff}
.tbl-hd{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#fafbfc;cursor:pointer}
.tbl-hd b{font-size:12.5px}
.tbl-hd .meta{font-size:11px;color:var(--ink2);margin-left:auto}
.tbl-bd{padding:8px 10px 10px;border-top:1px solid var(--bd);overflow:auto}
table.grid{border-collapse:collapse;width:100%;min-width:320px}
table.grid td{border:1px solid var(--bd);padding:0;vertical-align:top;position:relative}
table.grid td.idx{
  width:26px;text-align:center;font-size:10px;color:#98a0aa;background:#fafbfc;vertical-align:middle
}
table.grid td.op{width:22px;text-align:center;vertical-align:middle;background:#fafbfc}
table.grid td.op button{border:0;background:transparent;color:#c2c8d0;font-size:14px;line-height:1;padding:2px}
table.grid td.op button:hover{color:var(--danger)}
table.grid textarea{
  width:100%;border:0;background:transparent;padding:5px 6px;resize:vertical;outline:none;
  font:inherit;font-size:12px;line-height:1.5;min-height:28px;display:block
}
table.grid td:focus-within{outline:2px solid #0b6bcb;outline-offset:-1px;background:#f7fbff}
.tbl-ft{display:flex;gap:6px;margin-top:7px;flex-wrap:wrap}
tr.is-head td{background:#f4f7fb;font-weight:600}
tr.is-head textarea{font-weight:600}

/* ---------- 预览 ---------- */
.pv-bar{display:flex;align-items:center;gap:8px;margin-bottom:12px;color:#5f6672;font-size:12px}
.pv-bar .zoom{
  display:flex;background:#fff;border:1px solid var(--bd2);border-radius:7px;overflow:hidden
}
.pv-bar .zoom button{border:0;background:#fff;padding:4px 10px;font-size:12px;color:var(--ink2)}
.pv-bar .zoom button:hover{background:#f0f2f5}
.page{
  width:794px;margin:0 auto;background:#fff;box-shadow:0 2px 14px #0000001f;border-radius:2px;
  padding:96px 85px 96px 96px;
  font-family:"宋体",SimSun,serif;font-size:10.5pt;line-height:1.28;color:#000;
  transform-origin:top center;
}
.page.zoom{zoom:var(--z,1)}
.pg-body p{margin:4pt 0;text-indent:2em;text-align:justify}
.pg-body p.center{text-align:center;text-indent:0}
.pg-body h1{
  font-size:18pt;font-weight:700;margin:16pt 0 10pt;text-indent:0;line-height:1.35;
  border-top:1px solid #dfe3e8;padding-top:12pt
}
.pg-body h1:first-child{border-top:0;padding-top:0;margin-top:0}
.pg-body h2{font-size:16pt;font-weight:700;margin:12pt 0 8pt;text-indent:0;line-height:1.35}
.pg-body h3{font-size:15pt;font-weight:700;margin:10pt 0 6pt;text-indent:0;line-height:1.35}
.pg-body h4{font-size:14pt;font-weight:700;margin:10pt 0 6pt;text-indent:0;line-height:1.35}
.pg-body .lb{font-weight:700;font-size:12pt;margin:8pt 0 4pt;text-indent:0}
.pg-body .li{margin:2pt 0 2pt 2em;text-indent:-1.2em}
.pg-body .cover-title{font-size:26pt;font-weight:700;text-align:center;text-indent:0;margin:10pt 0;
  font-family:"微软雅黑",sans-serif}
.pg-body .cover-meta{text-align:center;text-indent:0;font-size:12pt;margin:4pt 0}
.pg-body .cover-brand{text-align:center;text-indent:0;font-size:16pt;font-weight:700;margin-top:8pt;
  font-family:"微软雅黑",sans-serif}
.pg-body img{max-width:100%;height:auto;display:block;margin:8pt auto}
.pg-body table{border-collapse:collapse;width:100%;margin:6pt 0;font-size:9.5pt;
  font-family:"宋体",SimSun,serif}
.pg-body td{border:1px solid #808080;padding:3pt 4pt;vertical-align:middle;line-height:1.3}
.pg-body td.hd{background:#eef3f9;font-weight:700;text-align:center}
.pg-body .empty-cell{color:transparent}
.pg-body hr.pgbr{border:0;border-top:1px dashed #d5dae0;margin:14pt 0}

/* ---------- 提示 ---------- */
.toast{
  position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(20px);
  background:#1c2026;color:#fff;padding:9px 16px;border-radius:8px;font-size:12.5px;
  opacity:0;pointer-events:none;transition:.25s;z-index:99
}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.banner{background:#fff4e5;border:1px solid #ffd9a0;color:#8a5a00;padding:9px 12px;border-radius:8px;
  font-size:12px;margin-bottom:10px}
.tools{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.help{background:#fff;border:1px solid var(--bd);border-radius:10px;padding:12px 14px;margin-bottom:10px;font-size:12px;color:#4a515c}
.help h4{margin:0 0 6px;font-size:12.5px}
.help ol{margin:0;padding-left:18px}
.help li{margin:2px 0}
.kbd{border:1px solid var(--bd2);border-bottom-width:2px;border-radius:4px;padding:0 4px;font-size:11px;background:#fafbfc}
.mini{font-size:11px;color:#8a9099}
.pill{display:inline-block;font-size:10px;padding:1px 6px;border-radius:99px;background:#eef1f5;color:#69707c}
.pill.ok{background:#e6f4ea;color:#137333}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand"><i>方</i>深信服云计算平台实施方案 · 生成器<small id="metaInfo"></small></div>
  <div class="spacer"></div>
  <button class="btn ghost" id="btnHelp">使用说明</button>
  <button class="btn" id="btnJson">导出配置</button>
  <button class="btn" id="btnImport">导入配置</button>
  <button class="btn" id="btnReset">恢复模板默认</button>
  <button class="btn" id="btnCopy">复制全文</button>
  <button class="btn" id="btnHtml">下载 HTML</button>
  <button class="btn primary" id="btnDocx">⬇ 下载实施方案 (.docx)</button>
  <input type="file" id="fileImport" accept=".json" hidden>
</header>

<div class="layout">
  <aside class="left" id="left">
    <div class="help" id="helpBox" hidden>
      <h4>使用说明</h4>
      <ol>
        <li>本工具已内置模板《深信服云计算平台实施方案》的全部章节结构（1 级～4 级标题、25 张表格）与 1148 个占位字段。</li>
        <li>“① 项目关键参数”里的内容会自动填充到全文对应位置（如客户名称、节点数量、IP 地址、负责人等）。</li>
        <li>“② 章节内容”按模板章节顺序排列，可直接修改任意段落、标题、表格单元格；表格支持增删行。</li>
        <li>右侧为实时预览。点击 <b>下载实施方案 (.docx)</b> 得到 Word 文件，<b>框架、顺序、样式、页眉页脚、拓扑图全部保留</b>。</li>
        <li>首次用 Word 打开时目录可能显示旧标题 —— 已开启“打开时更新域”，按 <span class="kbd">Ctrl+A</span> 再按 <span class="kbd">F9</span> 亦可刷新目录。</li>
        <li>所有输入会自动保存在浏览器本地，中途关闭不会丢失；也可“导出配置”备份为 JSON。</li>
      </ol>
    </div>
    <div id="banner"></div>
    <div id="paramBox"></div>
    <div class="tools">
      <button class="btn sm" id="btnIpGen">⚙ 按节点数生成 IP 规划表</button>
      <button class="btn sm" id="btnSchGen">⚙ 按开始日期生成实施周期</button>
      <button class="btn sm" id="btnExpand">全部展开</button>
      <button class="btn sm" id="btnCollapse">全部收起</button>
    </div>
    <div class="f" style="margin-bottom:10px">
      <input id="q" placeholder="🔍 搜索字段内容（如“防火墙”“项目经理”）">
    </div>
    <div id="formBox"></div>
    <div style="height:60px"></div>
  </aside>

  <section class="right">
    <div class="pv-bar">
      <span>实时预览（近似 Word 排版效果）</span>
      <span class="pill" id="pvStat"></span>
      <div class="spacer"></div>
      <div class="zoom">
        <button data-z="0.6">60%</button>
        <button data-z="0.75">75%</button>
        <button data-z="0.9">90%</button>
        <button data-z="1">100%</button>
      </div>
    </div>
    <div class="page zoom" id="page" style="--z:.9"><div class="pg-body" id="pv"></div></div>
  </section>
</div>

<div class="toast" id="toast"></div>

<script type="application/json" id="appData">__APP_DATA_JSON__</script>
<script type="text/plain" id="pkgB64">__PKG_B64__</script>
<script type="text/plain" id="docXmlB64">__DOCXML_B64__</script>
<script type="application/json" id="ovrData">__OVERRIDES_JSON__</script>

<script>
"use strict";
/* =====================================================================
   深信服云计算平台实施方案 · 生成器
   原理：模板 .docx 原包为基底，其中 word/document.xml 的文本节点已被
   替换为 __TK_nnnn__ 占位符。生成时把占位符换回用户输入，其余部件
   （样式表/编号/页眉页脚/图片/页面设置/表格合并）原样复用，
   从而 100% 保留原模板的框架、顺序与格式。
   ===================================================================== */
const NS_W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
const NS_R = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';
const NS_A = 'http://schemas.openxmlformats.org/drawingml/2006/main';
const XML_NS = 'http://www.w3.org/XML/1998/namespace';
const TOK_ONE = /__TK_\d+__/;        // 注意：不要用带 g 的正则做 .test()（lastIndex 会累积）
const TOK_ALL = /__TK_\d+__/g;

const DATA = JSON.parse(document.getElementById('appData').textContent);
const PKG_B64 = document.getElementById('pkgB64').textContent.trim();
const OVR = JSON.parse(document.getElementById('ovrData').textContent);
const DOCXML_B64 = document.getElementById('docXmlB64').textContent.trim();

/* ---------------- 基础工具 ---------------- */
const $ = s => document.querySelector(s);
const esc = s => String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;')
  .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
function b64ToBytes(b64){
  const bin = atob(b64.replace(/\s+/g,''));
  const u8 = new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) u8[i]=bin.charCodeAt(i);
  return u8;
}
function bytesToB64(u8){
  let s=''; const CH=0x8000;
  for(let i=0;i<u8.length;i+=CH) s+=String.fromCharCode.apply(null,u8.subarray(i,i+CH));
  return btoa(s);
}
const te = new TextEncoder(), td = new TextDecoder();

async function inflateRaw(u8){
  if(typeof DecompressionStream==='undefined') throw new Error('NO_DS');
  const ds=new DecompressionStream('deflate-raw');
  const w=ds.writable.getWriter(); w.write(u8); w.close();
  return new Uint8Array(await new Response(ds.readable).arrayBuffer());
}
async function deflateRaw(u8){
  if(typeof CompressionStream==='undefined') return null;
  const cs=new CompressionStream('deflate-raw');
  const w=cs.writable.getWriter(); w.write(u8); w.close();
  return new Uint8Array(await new Response(cs.readable).arrayBuffer());
}

/* CRC32 */
const CRC_T=(()=>{const t=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;
  for(let k=0;k<8;k++) c=c&1?0xEDB88320^(c>>>1):c>>>1; t[n]=c>>>0;} return t;})();
function crc32(u8){let c=0xFFFFFFFF;for(let i=0;i<u8.length;i++) c=CRC_T[(c^u8[i])&0xFF]^(c>>>8);
  return (c^0xFFFFFFFF)>>>0;}

/* ---------------- ZIP 读写 ---------------- */
function readZip(buf){
  const dv=new DataView(buf.buffer,0,buf.byteLength);
  let eocd=-1;
  for(let i=buf.length-22;i>=0&&i>buf.length-70000;i--)
    if(dv.getUint32(i,true)===0x06054b50){eocd=i;break;}
  if(eocd<0) throw new Error('ZIP 结构异常：未找到中央目录');
  const count=dv.getUint16(eocd+10,true);
  let off=dv.getUint32(eocd+16,true);
  const out=[];
  for(let i=0;i<count;i++){
    if(dv.getUint32(off,true)!==0x02014b50) throw new Error('ZIP 中央目录损坏');
    const method=dv.getUint16(off+10,true);
    const crc=dv.getUint32(off+16,true), csize=dv.getUint32(off+20,true), usize=dv.getUint32(off+24,true);
    const nlen=dv.getUint16(off+28,true), elen=dv.getUint16(off+30,true), clen=dv.getUint16(off+32,true);
    const lho=dv.getUint32(off+42,true);
    const name=td.decode(buf.subarray(off+46,off+46+nlen));
    const lnlen=dv.getUint16(lho+26,true), lelen=dv.getUint16(lho+28,true);
    const dataStart=lho+30+lnlen+lelen;
    out.push({name,method,crc,csize,usize,data:buf.subarray(dataStart,dataStart+csize)});
    off+=46+nlen+elen+clen;
  }
  return out;
}
function buildZip(files){
  const parts=[], central=[]; let offset=0;
  for(const f of files){
    const nb=te.encode(f.name);
    const lh=new Uint8Array(30+nb.length); const d1=new DataView(lh.buffer);
    d1.setUint32(0,0x04034b50,true); d1.setUint16(4,20,true); d1.setUint16(6,f.flags,true);
    d1.setUint16(8,f.method,true); d1.setUint16(10,0,true); d1.setUint16(12,0x2121,true);
    d1.setUint32(14,f.crc,true); d1.setUint32(18,f.csize,true); d1.setUint32(22,f.usize,true);
    d1.setUint16(26,nb.length,true); d1.setUint16(28,0,true); lh.set(nb,30);
    parts.push(lh,f.data);
    const ch=new Uint8Array(46+nb.length); const d2=new DataView(ch.buffer);
    d2.setUint32(0,0x02014b50,true); d2.setUint16(4,20,true); d2.setUint16(6,20,true);
    d2.setUint16(8,f.flags,true); d2.setUint16(10,f.method,true);
    d2.setUint16(12,0,true); d2.setUint16(14,0x2121,true);
    d2.setUint32(16,f.crc,true); d2.setUint32(20,f.csize,true); d2.setUint32(24,f.usize,true);
    d2.setUint16(28,nb.length,true); d2.setUint32(42,offset,true); ch.set(nb,46);
    central.push(ch);
    offset+=lh.length+f.data.length;
  }
  let cdSize=0; central.forEach(c=>cdSize+=c.length);
  const eo=new Uint8Array(22); const d3=new DataView(eo.buffer);
  d3.setUint32(0,0x06054b50,true); d3.setUint16(8,files.length,true);
  d3.setUint16(10,files.length,true); d3.setUint32(12,cdSize,true); d3.setUint32(16,offset,true);
  const total=offset+cdSize+22; const out=new Uint8Array(total);
  let p=0; for(const c of parts){out.set(c,p); p+=c.length;}
  for(const c of central){out.set(c,p); p+=c.length;}
  out.set(eo,p);
  return out;
}

/* ---------------- 状态 ---------------- */
let docDom=null, pkgBytes=null, tokNodes={}, seq=9000;
const values={}, dirty={}, tables=[];

/* ---------------- DOM 小工具 ---------------- */
const qc=(n,t)=>[...n.children].find(c=>c.localName===t);
const qa=(n,t)=>[...n.children].filter(c=>c.localName===t);
const attrW=(n,t)=>{const v=n&&n.getAttributeNS(NS_W,t); return v==null?null:v;};
function mkEl(tag){return document.createElementNS(NS_W,'w:'+tag);}

/* ---------------- 初始化 ---------------- */
async function boot(){
  if(typeof DecompressionStream==='undefined'){
    $('#banner').innerHTML='<div class="banner">当前浏览器不支持流式解压（DecompressionStream），'
      +'无法生成文档。请用 <b>Chrome / Edge 103+</b> 或其他新版浏览器打开本文件。</div>';
    return;
  }
  const xml=td.decode(await inflateRaw(b64ToBytes(DOCXML_B64)));
  docDom=new DOMParser().parseFromString(xml,'application/xml');
  pkgBytes=b64ToBytes(PKG_B64);
  indexTokens();
  buildTableRefs();   // 必须在写入取值之前建立索引（否则单元格里已是文本而非占位符）
  loadSaved();
  renderParams(); renderForm(); renderPreview();
  $('#metaInfo').textContent='· '+DATA.meta.paragraph_count+' 段落 / '+DATA.meta.table_count
    +' 表格 / '+DATA.meta.token_count+' 字段';
}
function indexTokens(){
  tokNodes={};
  const ts=docDom.getElementsByTagNameNS(NS_W,'t');
  for(const t of ts){
    const m=/__TK_\d+__/.exec(t.textContent);
    if(m){ tokNodes[m[0]]=t; t.__tok=m[0]; }
  }
}
/* 表格：按文档顺序记录每张表的行节点与单元格 token */
function buildTableRefs(){
  const body=docDom.getElementsByTagNameNS(NS_W,'body')[0];
  let ti=0;
  for(const el of [...body.children]){
    if(el.localName!=='tbl') continue;
    ti++;
    const rows=[];
    for(const tr of qa(el,'tr')){
      const cells=[];
      for(const tc of qa(tr,'tc')){
        const p=qc(tc,'p'); const r=p?qc(p,'r'):null; const tn=r?qc(r,'t'):null;
        const id=tn?(tn.__tok||(TOK_ONE.test(tn.textContent)?tn.textContent.trim():null)):null;
        cells.push(id&&tokNodes[id]?id:null);
      }
      rows.push({tr,cells,del:false});
    }
    tables[ti]={el,rows};
  }
}

/* ---------------- 取值 / 公式 ---------------- */
function paramVal(k){const p=DATA.params.find(x=>x.k===k); return p?p.val:'';}
function evalFormula(tpl){
  return String(tpl).replace(/\{(\w+)([+\-*/]\d+)?\}/g,(m,k,op)=>{
    let v=paramVal(k); if(v===''||v==null) return '';
    if(op){
      const n=Number(v); if(!isNaN(n)) v=String(eval(n+op));
    }
    return v;
  });
}
/* 未手工改动的字段按公式联动 */
function refreshFormulas(){
  for(const tok in DATA.formulas){
    if(dirty[tok]) continue;
    values[tok]=evalFormula(DATA.formulas[tok]);
    writeToken(tok,values[tok]);
  }
}
/* 把值写入 document.xml 的 <w:t>（支持多行 -> w:br） */
function writeToken(tok,val){
  const t=tokNodes[tok]; if(!t) return;
  const r=t.parentNode;
  const lines=String(val==null?'':val).split('\n');
  const nx0=r.nextElementSibling;
  if((!nx0||!nx0.__gen)&&lines.length===1&&t.textContent===lines[0]) return; // 无变化，跳过
  let nx=nx0;
  while(nx&&nx.__gen){const n2=nx.nextElementSibling; r.parentNode.removeChild(nx); nx=n2;}
  t.setAttributeNS(XML_NS,'xml:space','preserve');
  t.textContent=lines[0];
  const rpr=qc(r,'rPr');
  let ref=r;
  for(let i=1;i<lines.length;i++){
    const nr=mkEl('r'); nr.__gen=1;
    if(rpr) nr.appendChild(rpr.cloneNode(true));
    const br=mkEl('br'); br.__gen=1; nr.appendChild(br);
    const nt=mkEl('t'); nt.__gen=1; nt.setAttributeNS(XML_NS,'xml:space','preserve');
    nt.textContent=lines[i]; nr.appendChild(nt);
    ref.parentNode.insertBefore(nr,ref.nextSibling); ref=nr;
  }
}
function applyAll(){
  for(const tok in tokNodes){
    if(tok in values) writeToken(tok,values[tok]);
  }
}
/* 克隆一个块（段落/行）并为其中的占位符分配新 token
   注意：取值写入后 <w:t> 里已经是文本，必须用 __tok 标记按位置配对*/
function cloneWithTokens(srcNode,insertAfter){
  const c=srcNode.cloneNode(true);
  const st=[...srcNode.getElementsByTagNameNS(NS_W,'t')];
  const ct=[...c.getElementsByTagNameNS(NS_W,'t')];
  const map={};
  for(let i=0;i<ct.length;i++){
    const old=st[i]&&st[i].__tok;
    if(!old||tokNodes[old]!==st[i]) continue;
    const nt='__TK_'+(++seq)+'__';
    map[old]=nt;
    tokNodes[nt]=ct[i];
    values[nt]='';
    ct[i].__tok=nt;
    ct[i].textContent=nt;
  }
  insertAfter.parentNode.insertBefore(c,insertAfter.nextSibling);
  return {node:c,map};
}

/* ---------------- 参数表单 ---------------- */
function renderParams(){
  const groups={};
  DATA.params.forEach(p=>{ (groups[p.grp]=groups[p.grp]||[]).push(p); });
  let h='<details class="card" open><summary><span class="caret">▶</span>'
    +'<span class="lv">①</span>项目关键参数<span class="cnt">改动后自动填充全文</span></summary><div class="bd">';
  for(const g in groups){
    h+='<div class="mline">'+esc(g)+'</div>';
    h+='<div class="grid2">';
    for(const p of groups[g]){
      const wide=(p.type==='text'&&String(p.val).length>16)?' style="grid-column:1/-1"':'';
      h+='<div class="f"'+wide+'><label>'+esc(p.label)+'</label><input data-param="'+p.k+'" type="'
        +(p.type==='number'?'number':p.type==='date'?'date':'text')+'" value="'+esc(p.val)+'">'
        +(p.hint?'<div class="hint">'+esc(p.hint)+'</div>':'')+'</div>';
    }
    h+='</div>';
  }
  h+='</div></details>';
  $('#paramBox').innerHTML=h;
}

/* ---------------- 章节表单 ---------------- */
function renderForm(){
  let h='<details class="card" open><summary><span class="caret">▶</span><span class="lv">②</span>'
    +'章节内容（按模板顺序）<span class="cnt">'+DATA.sections.length+' 节</span></summary><div class="bd">';
  DATA.sections.forEach((s,si)=>{
    const cnt=s.items.reduce((a,i)=>a+(i.kind==='table'?i.rows.length:(i.kind==='list'?i.toks.length:1)),0);
    h+='<details class="card sec" data-sec="'+si+'"'+((!s.adv&&si<3)?' open':'')+'>'
      +'<summary><span class="caret">▶</span>'+esc(s.title)
      +'<span class="cnt">'+cnt+' 项</span></summary><div class="bd">';
    if(s.note) h+='<div class="mini" style="margin:2px 0 8px">'+esc(s.note)+'</div>';
    s.items.forEach((it,ii)=>{
      if(it.kind==='h'){
        const lv=it.level||1;
        h+='<div class="field"><span class="tag h">H'+lv+' 标题</span>'
         +'<input class="tin" data-tok="'+it.tok+'"></div>';
      }else if(it.kind==='p'){
        h+='<div class="field"><span class="tag">段落</span>'
         +'<textarea data-tok="'+it.tok+'" rows="2"></textarea></div>';
      }else if(it.kind==='list'){
        h+='<div class="field"><span class="tag l">'
         +(it.style==='bullet'?'项目符号列表':'编号列表')+'（每行一条）</span>'
         +'<textarea data-list="'+si+'.'+ii+'" rows="'+Math.max(3,it.toks.length)+'"></textarea></div>';
      }else if(it.kind==='media'){
        h+='<div class="media">🖼 '+esc(it.note)+'</div>';
      }else if(it.kind==='table'){
        h+=tableEditor(it,si,ii);
      }
    });
    h+='</div></details>';
  });
  h+='</div></details>';
  $('#formBox').innerHTML=h;
  // 回填值
  document.querySelectorAll('[data-tok]').forEach(n=>{ n.value=values[n.dataset.tok]||''; autoGrow(n); });
  document.querySelectorAll('[data-list]').forEach(n=>{
    const it=listItem(n.dataset.list); n.value=it.toks.map(t=>values[t]||'').join('\n'); autoGrow(n);
  });
}
function listItem(key){
  const [si,ii]=key.split('.').map(Number);
  return DATA.sections[si].items[ii];
}
function tableEditor(it,si,ii){
  const T=tables[it.ti];
  let h='<div class="tbl" data-ti="'+it.ti+'"><div class="tbl-hd" data-toggle="'+it.ti+'">'
    +'<b>▦ '+esc(it.title)+'</b><span class="meta">'+it.rows.length+' 行 × '
    +(it.rows[0]?it.rows[0].length:0)+' 列</span></div><div class="tbl-bd" hidden>';
  h+='<table class="grid"><tbody>';
  it.rows.forEach((row,ri)=>{
    h+='<tr class="'+(ri<it.nhead?'is-head':'')+'" data-row="'+ri+'">'
      +'<td class="idx">'+(ri+1)+'</td>';
    row.forEach((tok,ci)=>{
      const v=tok?(values[tok]||''):'';
      h+='<td>'+(tok?'<textarea data-tok="'+tok+'" rows="1">'+esc(v)+'</textarea>'
        :'<div class="mini" style="padding:6px">（合并/图形单元格）</div>')+'</td>';
    });
    h+='<td class="op">'+(ri<it.nhead?'':'<button data-delrow="'+it.ti+'.'+ri+'" title="删除本行">×</button>')+'</td>';
    h+='</tr>';
  });
  h+='</tbody></table>';
  h+='<div class="tbl-ft">';
  if(it.repeat) h+='<button class="btn sm" data-addrow="'+it.ti+'">＋ 添加一行</button>';
  if(it.gen==='ip') h+='<button class="btn sm" data-genip="1">⚙ 按节点数自动生成</button>';
  if(it.gen==='sch') h+='<button class="btn sm" data-gensch="1">⚙ 按开始日期排期</button>';
  h+='</div></div></div>';
  return h;
}
function autoGrow(n){ n.style.height='auto'; n.style.height=Math.max(28,n.scrollHeight)+'px'; }

/* ---------------- 预览 ---------------- */
let imgCache={};
function debounce(fn,ms){let h;return function(){clearTimeout(h);h=setTimeout(fn,ms);};}
const schedulePreview=debounce(()=>{renderPreview();},130);
const scheduleSave=debounce(()=>{save();},900);
async function renderPreview(){
  if(!docDom) return;
  applyAll();
  const body=docDom.getElementsByTagNameNS(NS_W,'body')[0];
  const out=[]; const num={1:0,2:0,3:0,4:0}; let lc={};
  const blocks=[];
  const walk=(node)=>{ for(const el of [...node.children]){
      if(el.localName==='tbl'||el.localName==='p') blocks.push(el);
      else if(el.localName==='sdt'||el.localName==='sdtContent'){ const c=qc(el,'sdtContent'); if(c) walk(c); }
  }};
  walk(body);
  for(const el of blocks){
    if(el.localName==='p') out.push(renderP(el,num,lc));
    else out.push(await renderTbl(el));
  }
  $('#pv').innerHTML=out.join('')||'<p class="mini">（空）</p>';
  $('#pvStat').textContent=blocks.length+' 个块';
}
function cellText(tc){
  return [...tc.getElementsByTagNameNS(NS_W,'t')].map(t=>t.textContent).join('\n');
}
function ptext(p){
  let s='';
  const walkT=(n)=>{for(const c of n.children){
      const ln=c.localName;
      if(ln==='t') s+=c.textContent;
      else if(ln==='br'||ln==='cr') s+='\n';
      else if(ln==='tab') s+='\t';
      else if(ln==='drawing'||ln==='pict'||ln==='object'||ln==='AlternateContent') continue;
      else if(ln!=='rPr'&&ln!=='pPr') walkT(c);
  }};
  for(const r of [...p.children]) if(r.localName==='r'||r.localName==='hyperlink') walkT(r);
  return s;
}
function renderP(p,num,lc){
  const ppr=qc(p,'pPr');
  const style=ppr?attrW(qc(ppr,'pStyle'),'val'):null;
  const txt=ptext(p);
  const hasImg=p.getElementsByTagNameNS(NS_W,'drawing').length>0
             ||p.getElementsByTagNameNS(NS_W,'pict').length>0;
  let cls='', tag='p', html='';
  if(style==='SANGFOR11'){ num[1]++; num[2]=num[3]=num[4]=0; tag='h1'; html=num[1]+'. '+esc(txt);}
  else if(style==='SANGFOR22'){ num[2]++; num[3]=num[4]=0; tag='h2';
    html=[1,2].map(i=>num[i]).join('.')+'. '+esc(txt);}
  else if(style==='SANGFOR33'){ num[3]++; num[4]=0; tag='h3';
    html=[1,2,3].map(i=>num[i]).join('.')+'. '+esc(txt);}
  else if(style==='SANGFOR44'){ num[4]++; tag='h4';
    html=[1,2,3,4].map(i=>num[i]).join('.')+'. '+esc(txt);}
  else if(style==='SANGFORf'){ tag='div'; cls='lb'; html=esc(txt);}
  else if(style==='SANGFOR20'){ tag='div'; cls='cover-brand'; html=esc(txt);}
  else if(style==='ItemListCharSANGFOR'){ tag='div'; cls='li'; html='● '+esc(txt);}
  else {
    const npr=ppr?qc(ppr,'numPr'):null;
    const nid=npr?attrW(qc(npr,'numId'),'val'):null;
    const t=txt.trim();
    if(nid){
      lc.key=lc.key===nid?lc.key:(lc.key=nid);
      lc[nid]=(lc[nid]||0)+1;
      const isBullet=(nid==='18'||nid==='22'||nid==='4');
      tag='div'; cls='li';
      html=(isBullet?'● ':'（'+(lc[nid])+'）')+esc(txt);
    } else if(!t){ html=''; }
    else if(t===paramVal('projectTitle')){ cls='cover-title'; html=esc(txt); }
    else if(/^(文档版本|发布日期)/.test(t)){ cls='cover-meta'; html=esc(txt); }
    else html=esc(txt);
  }
  html=html.replace(/\n/g,'<br>');
  if(hasImg){
    const imgs=imgTags(p);
    html+=imgs||'<div class="mini" style="text-align:center">［此处为模板内置图形：'
      +'网络拓扑图 / 部署流程图，Word 中正常显示］</div>';
  }
  if(tag==='p'&&!html) return '<p>&nbsp;</p>';
  return '<'+tag+(cls?' class="'+cls+'"':'')+'>'+(html||'&nbsp;')+'</'+tag+'>';
}
function imgTags(p){
  const rels=getRels(); let h='';
  for(const blip of p.getElementsByTagNameNS(NS_A,'blip')){
    const id=blip.getAttributeNS(NS_R,'embed')||blip.getAttribute('r:embed');
    const target=rels[id]; if(!target) continue;
    if(imgCache[target]) h+='<img src="'+imgCache[target]+'">';
  }
  return h;
}
let relsCache=null;
function getRels(){ return relsCache||{}; }
async function loadImages(){
  try{
    const entries=readZip(pkgBytes);
    const e=entries.find(x=>x.name==='word/_rels/document.xml.rels');
    if(!e) return;
    let raw=e.data;
    if(e.method===8) raw=await inflateRaw(raw);
    const map={};
    for(const m of td.decode(raw).matchAll(/Id="([^"]+)"[^>]*Target="([^"]+)"/g)) map[m[1]]=m[2];
    relsCache=map;
    for(const id in map){
      const t=map[id];
      if(!/\.(png|jpe?g|gif)$/i.test(t)) continue;
      if(imgCache[t]) continue;
      const f=entries.find(x=>x.name==='word/'+t.replace(/^\.?\//,''));
      if(!f) continue;
      let data=f.data;
      if(f.method===8) data=await inflateRaw(data);
      const mime=/\.png$/i.test(t)?'image/png':/\.jpe?g$/i.test(t)?'image/jpeg':'image/gif';
      imgCache[t]=URL.createObjectURL(new Blob([data],{type:mime}));
    }
    schedulePreview();
  }catch(err){ console.warn('图片解析失败',err); }
}
async function renderTbl(tbl){
  const trs=qa(tbl,'tr');
  const cells=[]; const vstart={};
  trs.forEach((tr,ri)=>{
    let ci=0;
    for(const tc of qa(tr,'tc')){
      const tcpr=qc(tc,'tcPr');
      const gs=parseInt(attrW(qc(tcpr,'gridSpan'),'val')||'1',10)||1;
      const vm=qc(tcpr,'vMerge');
      const vval=vm?(attrW(vm,'val')||'continue'):null;
      if(vval==='continue'&&vstart[ci]){ vstart[ci].rs++; ci+=gs; continue; }
      const shd=qc(tcpr,'shd');
      const pp=qc(tc,'p'); const ppr=pp?qc(pp,'pPr'):null;
      const c={r:ri,c:ci,gs,rs:1,txt:cellText(tc),
        fill:shd?attrW(shd,'fill'):null,
        jc:ppr?attrW(qc(ppr,'jc'),'val'):null};
      c.blank=!c.txt.trim();
      cells.push(c);
      if(vval==='restart') vstart[ci]=c;
      ci+=gs;
    }
  });
  const byRow=trs.map(()=>[]);
  cells.forEach(c=>byRow[c.r].push(c));
  let h='<table>';
  byRow.forEach(line=>{
    if(!line.length){ h+='<tr><td></td></tr>'; return; }
    h+='<tr>';
    for(const c of line){
      const filled=c.fill&&!/^(auto|FFFFFF|ffffff)$/.test(c.fill);
      let st='';
      if(filled){
        st='background:#'+c.fill;
        const n=parseInt(c.fill.replace(/^#/,''),16);
        const lum=(((n>>16)&255)*0.299+((n>>8)&255)*0.587+(n&255)*0.114);
        if(lum<140) st+=';color:#fff';
      }
      const isHd=filled||c.jc==='center';
      h+='<td'+(c.gs>1?' colspan="'+c.gs+'"':'')+(c.rs>1?' rowspan="'+c.rs+'"':'')
        +(st?' style="'+st+'"':(isHd?' class="hd"':''))
        +'>'+(c.blank?'<span class="empty-cell">·</span>':esc(c.txt).replace(/\n/g,'<br>'))+'</td>';
    }
    h+='</tr>';
  });
  return h+'</table>';
}

/* ---------------- 事件 ---------------- */
const toast=(m)=>{const t=$('#toast'); t.textContent=m; t.classList.add('on');
  clearTimeout(t.__h); t.__h=setTimeout(()=>t.classList.remove('on'),1900);};

document.addEventListener('input',ev=>{
  const n=ev.target;
  if(n.dataset&&n.dataset.param){
    const p=DATA.params.find(x=>x.k===n.dataset.param); if(p) p.val=n.value;
    refreshFormulas(); schedulePreview(); scheduleSave(); return;
  }
  if(n.dataset&&n.dataset.tok){
    values[n.dataset.tok]=n.value; dirty[n.dataset.tok]=1;
    writeToken(n.dataset.tok,n.value); schedulePreview(); scheduleSave();
    if(n.tagName==='TEXTAREA') autoGrow(n);
    return;
  }
  if(n.dataset&&n.dataset.list){
    const it=listItem(n.dataset.list);
    const lines=n.value.split('\n');
    const host=n.closest('.field'); const key=n.dataset.list;
    // 行数多于字段数 -> 克隆最后一个列表段落
    let last=it.toks.length?tokNodes[it.toks[it.toks.length-1]]:null;
    while(lines.length>it.toks.length&&last){
      const prow=last.parentNode.parentNode;
      const r=cloneWithTokens(prow,prow);
      const nt=r.node.getElementsByTagNameNS(NS_W,'t')[0].textContent;
      it.toks.push(nt); values[nt]='';
      last=tokNodes[nt];
    }
    lines.forEach((v,i)=>{ if(i<it.toks.length){ values[it.toks[i]]=v; dirty[it.toks[i]]=1;
      writeToken(it.toks[i],v);} });
    schedulePreview(); scheduleSave(); autoGrow(n);
  }
});
document.addEventListener('click',async ev=>{
  const t=ev.target.closest('[data-toggle],[data-addrow],[data-delrow],[data-genip],[data-gensch],[data-z],#btnDocx,#btnCopy,#btnHtml,#btnReset,#btnJson,#btnImport,#btnHelp,#btnExpand,#btnCollapse,#btnIpGen,#btnSchGen');
  if(!t) return;
  if(t.dataset.toggle!==undefined){
    const bd=t.parentNode.querySelector('.tbl-bd'); bd.hidden=!bd.hidden; return;
  }
  if(t.dataset.z){ $('#page').style.setProperty('--z',t.dataset.z); return; }
  if(t.dataset.addrow){ addRow(Number(t.dataset.addrow)); return; }
  if(t.dataset.delrow){ delRow(t.dataset.delrow); return; }
  if(t.dataset.genip||t.id==='btnIpGen'){ genIp(); return; }
  if(t.dataset.gensch||t.id==='btnSchGen'){ genSchedule(); return; }
  if(t.id==='btnHelp'){ const h=$('#helpBox'); h.hidden=!h.hidden; return; }
  if(t.id==='btnExpand'){ document.querySelectorAll('details').forEach(d=>d.open=true); return; }
  if(t.id==='btnCollapse'){ document.querySelectorAll('details.sec').forEach(d=>d.open=false); return; }
  if(t.id==='btnReset'){
    if(!confirm('确定把所有内容恢复为模板默认值？当前编辑将丢失。')) return;
    try{ localStorage.removeItem('hci_plan_state'); }catch(e){}
    location.reload(); return;
  }
  if(t.id==='btnJson'){
    const blob=new Blob([JSON.stringify(exportState(),null,1)],{type:'application/json'});
    dl(blob,'实施方案配置.json'); return;
  }
  if(t.id==='btnImport'){ $('#fileImport').click(); return; }
  if(t.id==='btnCopy'){
    try{
      const html=styledHtml();
      await navigator.clipboard.write([new ClipboardItem({
        'text/html':new Blob([html],{type:'text/html'}),
        'text/plain':new Blob([$('#pv').innerText],{type:'text/plain'})})]);
      toast('已复制到剪贴板，可直接粘贴到 Word / WPS');
    }catch(e){ toast('复制失败，请改用“下载实施方案”'); }
    return;
  }
  if(t.id==='btnHtml'){
    const blob=new Blob([fullHtml()],{type:'text/html;charset=utf-8'});
    dl(blob,fileName('html')); return;
  }
  if(t.id==='btnDocx'){
    t.disabled=true; t.textContent='生成中…';
    try{ await makeDocx(); toast('已生成 Word 文档'); }
    catch(e){ console.error(e); toast('生成失败：'+(e&&e.message||e)); }
    t.disabled=false; t.textContent='⬇ 下载实施方案 (.docx)';
  }
});
$('#fileImport').addEventListener('change',async ev=>{
  const f=ev.target.files[0]; if(!f) return;
  try{
    const st=JSON.parse(await f.text());
    applyState(st); toast('配置已导入'); ev.target.value='';
  }catch(e){ toast('配置文件解析失败'); }
});
$('#q').addEventListener('input',ev=>{
  const q=ev.target.value.trim();
  document.querySelectorAll('#formBox details.sec').forEach(d=>{
    const hit=q?d.innerText.includes(q):true;
    d.style.display=hit?'':'none';
    if(q&&hit) d.open=true;
  });
});
window.addEventListener('beforeunload',save);

/* ---------------- 行增删 ---------------- */
function tableItem(ti){
  for(const s of DATA.sections) for(const it of s.items)
    if(it.kind==='table'&&it.ti===ti) return it;
  return null;
}
function addRow(ti){
  const T=tables[ti], it=tableItem(ti); if(!T) return;
  const src=T.rows[T.rows.length-1]; if(!src) return;
  const {node,map}=cloneWithTokens(src.tr,src.tr);
  const cells=src.cells.map(t=>t?(map[t]||null):null);
  T.rows.push({tr:node,cells,del:false});
  it.rows.push(cells);
  renderForm(); renderPreview(); save();
  toast('已添加一行，可在表格中填写');
}
function delRow(key){
  const [ti,ri]=key.split('.').map(Number); const T=tables[ti]; if(!T) return;
  const r=T.rows.splice(ri,1)[0]; if(!r) return;
  r.tr.parentNode.removeChild(r.tr);
  r.cells.forEach(t=>{ if(t){delete values[t]; delete tokNodes[t];} });
  const it=tableItem(ti); if(it) it.rows.splice(ri,1);
  renderForm(); renderPreview(); save();
}

/* ---------------- 智能生成器 ---------------- */
function rowTokens(ti){ return tables[ti].rows.map(r=>r.cells); }
function setCell(tok,v){ if(!tok) return; values[tok]=v; dirty[tok]=1; writeToken(tok,v); }
/* 找到“服务器IP规划”表（表头含 服务器/网络类型/聚合成员接口） */
function findTableByHeader(words){
  for(const it of DATA.sections) for(const itm of it.items){
    if(itm.kind!=='table') continue;
    const cells=itm.rows.slice(0,itm.nhead).flat().filter(Boolean);
    const head=cells.map(t=>DATA.tokens[t]||'').join(' | ');
    if(words.every(w=>head.includes(w))) return itm;
  }
  return null;
}
function genIp(){
  const it=findTableByHeader(['网络类型','聚合成员接口']);
  if(!it){ toast('未找到服务器IP规划表'); return; }
  const nodes=parseInt(paramVal('nodes')||'0',10);
  if(!(nodes>0)){ toast('请先填写节点数量'); return; }
  const T=tables[it.ti];
  while(T.rows.length-1>nodes*5) delRowRaw(it.ti,T.rows.length-1);
  while(T.rows.length-1<nodes*5) addRowRaw(it.ti);
  const pre=paramVal('mgmtPrefix'), gw=paramVal('mgmtGateway');
  const m0=Number(paramVal('mgmtStart')||0), b0=Number(paramVal('bmcStart')||0);
  const c=rowTokens(it.ti);
  for(let k=1;k<=nodes;k++){
    const base=1+(k-1)*5;
    const set=(r,col,v)=>{ const tok=T.rows[r].cells[col]; if(tok) setCell(tok,v); };
    set(base,0,'超融合服务器'+k);
    set(base,1,'管理口'); set(base,2,'Eth2-eth3'); set(base,3,pre+(m0+k-1)); set(base,5,gw);
    set(base+1,1,'vxlan');  set(base+1,2,'Eth4-eth5');
    set(base+2,1,'存储口'); set(base+2,2,'Eth8-eth9');
    set(base+3,1,'业务口'); set(base+3,2,'Eth6-eth7'); set(base+3,3,'业务口默认不配置IP，划分端口组即可');
    set(base+4,1,'MGMT口'); set(base+4,2,'MGMT'); set(base+4,3,pre+(b0+k-1));
  }
  renderForm(); renderPreview(); save();
  toast('IP 规划表已按 '+nodes+' 个节点生成');
}
function addRowRaw(ti){
  const T=tables[ti], it=tableItem(ti);
  const src=T.rows[T.rows.length-1]; if(!src) return;
  const {node,map}=cloneWithTokens(src.tr,src.tr);
  const cells=src.cells.map(t=>t?(map[t]||null):null);
  T.rows.push({tr:node,cells,del:false}); it.rows.push(cells);
}
function delRowRaw(ti,ri){
  const T=tables[ti], it=tableItem(ti);
  const r=T.rows.splice(ri,1)[0]; if(!r) return;
  r.tr.parentNode.removeChild(r.tr);
  r.cells.forEach(t=>{ if(t){delete values[t]; delete tokNodes[t];} });
  it.rows.splice(ri,1);
}
function genSchedule(){
  const it=findTableByHeader(['项目阶段','项目里程碑']);
  if(!it){ toast('未找到项目实施周期表'); return; }
  const T=tables[it.ti];
  const days=[3,5,5,5,10,7,2,3];
  let cur=new Date(paramVal('startDate')||new Date().toISOString().slice(0,10));
  if(isNaN(cur)) cur=new Date();
  for(let r=1;r<T.rows.length;r++){
    const d=days[r-1]!==undefined?days[r-1]:5;
    cur=new Date(cur.getTime()+d*86400000);
    const cell=T.rows[r].cells;
    if(cell[2]) setCell(cell[2],String(d));
    if(cell[3]) setCell(cell[3],cur.toISOString().slice(0,10));
  }
  renderForm(); renderPreview(); save();
  toast('实施周期已按开始日期推算完成时间');
}

/* ---------------- 导出 ---------------- */
function fileName(ext){
  const t=(paramVal('projectTitle')||'实施方案').replace(/[\\/:*?"<>|]/g,'');
  return t+'.'+ext;
}
function dl(blob,name){
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob); a.download=name; a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),4000);
}
function xmlText(){
  const s=new XMLSerializer().serializeToString(docDom);
  return /^<\?xml/.test(s) ? s
    : '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\r\n'+s;
}
async function makeDocx(){
  const zip=await buildDocxBytes();
  dl(new Blob([zip],
    {type:'application/vnd.openxmlformats-officedocument.wordprocessingml.document'}),
    fileName('docx'));
}
async function buildDocxBytes(){
  applyAll();
  const entries=readZip(pkgBytes);
  const files=[];
  const docBytes=te.encode(xmlText());
  for(const e of entries){
    let data=null;
    if(OVR[e.name]){
      const s=td.decode(await inflateRaw(b64ToBytes(OVR[e.name])));
      data=te.encode(substOvr(s));
    }else if(e.name==='word/document.xml'){
      data=docBytes;
    }else{
      files.push({name:e.name,method:e.method,flags:0x800,crc:e.crc,
        csize:e.csize,usize:e.usize,data:e.data});
      continue;
    }
    const comp=await deflateRaw(data);
    files.push(comp
      ? {name:e.name,method:8,flags:0x800,crc:crc32(data),csize:comp.length,usize:data.length,data:comp}
      : {name:e.name,method:0,flags:0x800,crc:crc32(data),csize:data.length,usize:data.length,data:data});
  }
  return buildZip(files);
}
function substOvr(s){
  return s.replace(/@@TITLE@@/g,escXml(paramVal('projectTitle')))
          .replace(/@@CUSTOMER@@/g,escXml(paramVal('customer')))
          .replace(/@@AUTHOR@@/g,'深信服科技股份有限公司')
          .replace(/@@DATE@@/g,new Date().toISOString().replace(/\.\d+Z$/,'Z'));
}
const escXml=s=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
function styledHtml(){
  const css='body{font-family:"宋体",SimSun,serif;font-size:10.5pt;line-height:1.28;color:#000}'
   +'h1{font-size:18pt;font-weight:700;margin:16pt 0 10pt}'
   +'h2{font-size:16pt;font-weight:700;margin:12pt 0 8pt}'
   +'h3{font-size:15pt;font-weight:700;margin:10pt 0 6pt}'
   +'h4{font-size:14pt;font-weight:700;margin:10pt 0 6pt}'
   +'p{margin:4pt 0;text-indent:2em;text-align:justify}'
   +'table{border-collapse:collapse;width:100%;font-size:9.5pt}'
   +'td{border:1px solid #808080;padding:3pt 4pt}'
   +'.lb{font-weight:700;font-size:12pt}.li{margin:2pt 0 2pt 2em}'
   +'.cover-title{font-size:26pt;font-weight:700;text-align:center;text-indent:0}'
   +'.cover-meta{text-align:center;text-indent:0}';
  return '<html><head><meta charset="utf-8"><style>'+css+'</style></head><body>'
    +$('#pv').innerHTML+'</body></html>';
}
function fullHtml(){
  const css='body{background:#eef1f4;margin:0;padding:24px}'
   +'.page{width:794px;margin:0 auto;background:#fff;padding:96px 96px;box-shadow:0 2px 14px #0002}'
   +'body{font-family:"宋体",SimSun,serif;font-size:10.5pt;line-height:1.28;color:#000}'
   +'h1{font-size:18pt;font-weight:700;margin:16pt 0 10pt}'
   +'h2{font-size:16pt;font-weight:700;margin:12pt 0 8pt}'
   +'h3{font-size:15pt;font-weight:700;margin:10pt 0 6pt}'
   +'h4{font-size:14pt;font-weight:700;margin:10pt 0 6pt}'
   +'p{margin:4pt 0;text-indent:2em;text-align:justify}'
   +'table{border-collapse:collapse;width:100%;font-size:9.5pt;margin:6pt 0}'
   +'td{border:1px solid #808080;padding:3pt 4pt}'
   +'img{max-width:100%}.pg{page-break-after:always}';
  return '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>'
    +esc(paramVal('projectTitle'))+'</title><style>'+css+'</style></head><body><div class="page">'
    +$('#pv').innerHTML+'</div></body></html>';
}

/* ---------------- 本地存储 / 配置导入导出 ---------------- */
function exportState(){
  return {v:1,params:DATA.params.map(p=>[p.k,p.val]),
    values:values,mtime:new Date().toISOString()};
}
function applyState(st){
  if(!st) return;
  (st.params||[]).forEach(([k,v])=>{ const p=DATA.params.find(x=>x.k===k); if(p) p.val=v; });
  if(st.values) for(const k in st.values){ if(k in tokNodes){ values[k]=st.values[k]; dirty[k]=1; } }
  renderParams(); renderForm(); renderPreview(); save();
}
function save(){ try{ localStorage.setItem('hci_plan_state',JSON.stringify(exportState())); }catch(e){} }
function loadSaved(){
  Object.assign(values,DATA.tokens);
  Object.keys(DATA.tokens).forEach(k=>{dirty[k]=1;});   // 模板默认值视为“已定值”
  try{
    const st=JSON.parse(localStorage.getItem('hci_plan_state')||'null');
    if(st){
      (st.params||[]).forEach(([k,v])=>{ const p=DATA.params.find(x=>x.k===k); if(p) p.val=v; });
      for(const k in (st.values||{})) if(k in tokNodes) values[k]=st.values[k];
    }
  }catch(e){}
  Object.keys(DATA.formulas).forEach(k=>{ delete dirty[k]; });  // 仅公式字段随参数联动
  refreshFormulas();
  for(const k in values) writeToken(k,values[k]);
}

/* 自检模式：文件后加 ?selftest=1 打开，会把端到端结果写入页面（供自动化校验用） */
async function selfTest(){
  const rep={ok:false};
  try{
    rep.sections=DATA.sections.length;
    rep.tokens=Object.keys(tokNodes).length;
    const findTok=f=>Object.keys(values).find(k=>String(values[k]).includes(f));
    DATA.params.find(p=>p.k==='customer').val='测试客户集团';
    DATA.params.find(p=>p.k==='projectTitle').val='测试客户集团超融合实施方案';
    DATA.params.find(p=>p.k==='nodes').val='8';
    DATA.params.find(p=>p.k==='mgmtStart').val='10';
    refreshFormulas();
    rep.bg=String(values[findTok('因业务发展需求')]||'').slice(0,60);
    rep.range=String(values[findTok('建设一套')]||'').slice(0,50);
    writeToken(findTok('因业务发展需求'),'第一行\n第二行\n第三行');
    genIp();
    const ipT=findTableByHeader(['网络类型','聚合成员接口']);
    rep.ipTi=ipT.ti;
    rep.tblSizes=Object.keys(tables).map(k=>k+':'+tables[k].rows.length).join(' ');
    const domT=tables[ipT.ti];
    rep.domHead=qa(domT.el,'tr')[0]?[...qa(qa(domT.el,'tr')[0],'tc')].map(tc=>{
      const p=qc(tc,'p'); const rr=p?qc(p,'r'):null; const tt=rr?qc(rr,'t'):null;
      return tt?tt.textContent:'?';}).join('|'):'nohead';
    rep.ipCells1=JSON.stringify((domT.rows[1]||{}).cells);
    rep.ipRows=domT.rows.length;
    rep.ip8list=Object.keys(values).filter(k=>String(values[k]).indexOf('超融合服务器8')>=0)
      .map(k=>k+'='+values[k]).join(' ; ');
    rep.row36=JSON.stringify((tables[10].rows[36]||{}).cells||null);
    rep.row36vals=((tables[10].rows[36]||{}).cells||[]).map(t=>t+'='+values[t]).join(' | ');
    rep.row1vals=((tables[10].rows[1]||{}).cells||[]).map(t=>t+'='+values[t]).join(' | ');
    rep.ip8=String(values[findTok('超融合服务器8')]||'');
    genSchedule();
    rep.schedOk=!!values[findTok('2026-09-1')];
    await loadImages();
    rep.imgCount=Object.keys(imgCache).length;
    await renderPreview();
    rep.previewLen=document.getElementById('pv').innerHTML.length;
    rep.previewHasTable=document.querySelectorAll('#pv table').length;
    rep.previewHasImg=document.querySelectorAll('#pv img').length;
    const zip=await buildDocxBytes();
    rep.bytes=zip.length;
    rep.leftover=(xmlText().match(/__TK_\d+__/g)||[]).length;
    rep.xmlDecl=(xmlText().match(/<\?xml/g)||[]).length;
    rep.b64=bytesToB64(zip);
    rep.ok=true;
  }catch(e){ rep.err=String((e&&e.stack)||e); }
  const pre=document.createElement('pre');
  pre.id='selfTestOut';
  pre.textContent='##SELFTEST##'+JSON.stringify(rep)+'##END##';
  document.body.appendChild(pre);
  return rep;
}
window.__selfTest=selfTest;

boot().then(()=>{
  loadImages();
  if(location.search.indexOf('selftest')>=0) setTimeout(selfTest,300);
}).catch(e=>{
  console.error(e);
  $('#banner').innerHTML='<div class="banner">初始化失败：'+(e&&e.message||e)
    +'。请使用 Chrome / Edge 等新版浏览器打开本文件。</div>';
});
</script>
</body>
</html>
